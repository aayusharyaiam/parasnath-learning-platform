# Copy to apps/web/.env.local and apps/mobile/.env
# Create a project at https://supabase.com — Auth + Database only for v1.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Expo uses the same values (EXPO_PUBLIC_ prefix):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Web origin used as OAuth redirect (Google + email confirm)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# After first login, promote yourself in SQL Editor:
# update public.profiles set role = 'admin' where email = 'you@example.com';
#
# Dashboard setup:
# Auth → Providers → Email (enable)
# Auth → Providers → Google (client id/secret from Google Cloud)
# Auth → Providers → Phone (Twilio when you want real OTP)
# Auth → URL configuration → Redirect URLs:
#   http://localhost:3000/auth/callback
#   parasnath://auth/callback
